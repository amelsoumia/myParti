<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.Separator?>

<VBox alignment="TOP_CENTER" prefHeight="400.0" prefWidth="543.0" spacing="20.0" style="-fx-background-color: #f2ecee;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.myPartiApplication.MyPartiMyBookingsController">

    <padding>
        <Insets top="20.0" right="20.0" bottom="20.0" left="20.0" />
    </padding>

    <HBox alignment="BASELINE_CENTER" prefHeight="53.0" prefWidth="430.0">

        <VBox prefHeight="67.0" prefWidth="153.0">

            <Button fx:id="homeBtn" contentDisplay="CENTER" mnemonicParsing="false" onAction="#handleClickHomeBtn" prefHeight="32.0" prefWidth="92.0" style="-fx-background-color: transparent;" text="⬅🏠">

                     <cursor>
                        <Cursor fx:constant="HAND" />

                     </cursor>
                     <font>
                        <Font size="15.0" />
                     </font>

                  </Button>

            <Region prefHeight="9.0" prefWidth="65.0" />

        </VBox>

    <Region prefHeight="32.0" prefWidth="0.0" HBox.hgrow="ALWAYS" />

    <VBox alignment="BOTTOM_CENTER" prefHeight="35.0" prefWidth="399.0">

        <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="83.0" prefWidth="294.0" text="My Bookings" wrapText="true">

            <font>
                <Font name="Bell MT" size="50.0" />
            </font>

        </Label>

    </VBox>

    <Region prefHeight="32.0" prefWidth="141.0" HBox.hgrow="ALWAYS" />

    </HBox>

    <Separator halignment="CENTER" prefWidth="200.0">

        <VBox.margin>
            <Insets bottom="30.0" />
        </VBox.margin>

    </Separator>

    <SplitPane dividerPositions="0.4664586583463338" prefHeight="500.0" prefWidth="200.0" style="-fx-box-border: transparent; -fx-background-color: transparent;">

        <items>

            <VBox alignment="TOP_CENTER" prefHeight="51.0" prefWidth="153.0" spacing="10.0">

                  <ListView fx:id="bookingsList" focusTraversable="false" prefHeight="200.0" prefWidth="200.0" style="-fx-font-size: 15px; -fx-font-family: Arial; -fx-opacity: 0.9;">

                      <cursor>
                        <Cursor fx:constant="HAND" />
                      </cursor>

                  </ListView>

            </VBox>

            <VBox alignment="TOP_CENTER" prefHeight="189.0" prefWidth="349.0" spacing="10.0">

                <Label fx:id="bookingDetails" alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" style="-fx-background-color: transparent;" text="Booking Info" textAlignment="LEFT" wrapText="true" VBox.vgrow="ALWAYS">

                    <font>
                        <Font name="Arial" size="20.0" />
                    </font>

                </Label>

                <Button fx:id="cancelBookingBtn" alignment="BOTTOM_LEFT" contentDisplay="CENTER" mnemonicParsing="false" onAction="#cancelBooking" style="-fx-background-color: WHITE; -fx-padding: 7 12 7 12; -fx-border-color: BLACK; -fx-border-radius: 6; -fx-background-radius: 6;" text="Cancel ">

                    <font>
                        <Font name="Arial" size="15.0" />
                    </font>

                    <cursor>
                        <Cursor fx:constant="HAND" />
                    </cursor>

                </Button>

            </VBox>

        </items>

    </SplitPane>

</VBox>
